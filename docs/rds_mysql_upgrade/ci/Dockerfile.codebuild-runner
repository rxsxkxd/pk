# CodeBuild Step 3/4/5 用の軽量な実行 image。
# Docker CLI/Buildx は VerifyGreen の Go バイナリ用マルチステージビルドに使う。
FROM docker:27.5-cli AS docker-cli
FROM public.ecr.aws/aws-cli/aws-cli:2.37.1 AS aws-cli

# 設定 YAML の読み取りに使う Ruby。compose.yaml の ruby サービスと同じ版で固定する。
# YAML / JSON はどちらも標準ライブラリなので、追加パッケージの導入は要らない。
FROM ruby:3.4.10-slim-bookworm

# Shell scripts、JSON 読み取り（jq）、apt による任意の mysql-client 導入、TLS、
# Docker CLI 実行に必要な最小パッケージ。
RUN apt-get update \
  && apt-get install --no-install-recommends -y bash ca-certificates jq sudo \
  && rm -rf /var/lib/apt/lists/*

# AWS CLI v2 は公式イメージから、Docker CLI と Buildx は公式 Docker CLI イメージから取り込む。
COPY --from=aws-cli /usr/local/aws-cli /usr/local/aws-cli
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker-cli /usr/local/libexec/docker/cli-plugins/docker-buildx /usr/local/libexec/docker/cli-plugins/docker-buildx

# AWS 公式 image の /usr/local/bin/aws はシンボリックリンクである。COPY で実体だけを
# 取り出すと、AWS CLI 同梱の libpython を見つけられないため、コピー済みの配下へリンクする。
RUN ln -s /usr/local/aws-cli/v2/current/bin/aws /usr/local/bin/aws

WORKDIR /workspace
