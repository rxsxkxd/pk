# 実接続時のみ、このファイルを docker/.env へコピーして絶対パスへ置き換える。
# 未設定時は compose.yaml が Git 管理下の空ディレクトリを read-only でマウントする。
# docker/.env は Git 管理しない。

# AWS CLI の config、credentials、SSO cache を含むディレクトリ。
AWS_CONFIG_DIR=/absolute/path/to/.aws
AWS_PROFILE=default

# RDS CA bundle（例: global-bundle.pem）を格納したディレクトリ。
RDS_CA_DIR=/absolute/path/to/rds-ca

# 任意の MySQL クライアント設定を格納したディレクトリ。
# my.cnf に DB ユーザーやパスワードを格納する場合、所有者だけが読める権限にする。
MYSQL_CLIENT_CONFIG_DIR=/absolute/path/to/mysql-client-config

# このリポジトリの絶対パス。SQL、収集 JSON、レポートの入出力に使用する。
WORKSPACE_DIR=/absolute/path/to/rds_mysql_upgrade
