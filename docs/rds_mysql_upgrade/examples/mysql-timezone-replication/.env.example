# ローカル検証環境用。このファイルを .env にコピーして使う。
# .env は Git 管理しない（リポジトリルートの .gitignore で除外済み）。
#
# 使い捨てのローカル検証環境専用の値である。実環境の認証情報を書かない。
# ポートは 127.0.0.1 にのみ公開されるため、外部からは接続できない。
MYSQL_ROOT_PASSWORD=tzcheck-local-only
# source の tzcheck_app 用。未指定時も compose.yaml のローカル検証用既定値で起動する。
MYSQL_APP_PASSWORD=tzcheck-app-local-only
