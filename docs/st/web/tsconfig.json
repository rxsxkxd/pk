{
  "compilerOptions": {
    "target": "es2023",
    "lib": [
      "es2023",
      "dom",
      "dom.iterable"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": [
      "vite/client",
      "node"
    ],
    "strict": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "paths": {
      "@mode": [
        "./src/modes/page/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "test",
    "vite.config.ts"
  ]
}
